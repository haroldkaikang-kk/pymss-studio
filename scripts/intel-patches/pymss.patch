diff --git a/pymss/separator.py b/pymss/separator.py
index a5bb01f..33a5580 100644
--- a/pymss/separator.py
+++ b/pymss/separator.py
@@ -90,6 +90,14 @@ def _resolve_public_device(device, inference_params, logger):
         Any: Resolved value."""
     inference_params = dict(inference_params or {})
     requested_device = device
+    # AMD MPS on Intel does not imply Apple Silicon MLX support. Apply at
+    # the engine boundary as well so imported workflows follow the same rule.
+    if platform.system() == "Darwin" and platform.machine().lower() in {"x86_64", "amd64"}:
+        if requested_device in {"auto", "mps", "mlx"}:
+            logger.info("Intel macOS compatibility: using CPU (requested %s)", requested_device)
+            requested_device = "cpu"
+        if requested_device == "cpu":
+            inference_params = {k: v for k, v in inference_params.items() if not k.startswith("mps_")}
     if requested_device == "mlx":
         if not torch.backends.mps.is_available():
             raise RuntimeError("device='mlx' requires Apple Silicon MPS support")
